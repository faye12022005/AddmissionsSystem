DB_HOST=localhost
DB_PORT=3306
DB_NAME=addmissionssystem
DB_USER=root
DB_PASSWORD=pipiphu123
DB_DRIVER=com.mysql.cj.jdbc.Driver

HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
